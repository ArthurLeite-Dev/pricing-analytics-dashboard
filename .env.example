# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > Config do SDK).
# O prefixo VITE_ é obrigatório para o Vite expor a variável ao código do navegador.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL base da API Node/Express (pasta /backend). Em desenvolvimento local
# geralmente é http://localhost:3001.
VITE_API_BASE_URL=http://localhost:3001
