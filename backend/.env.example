# Porta em que a API Express escuta
PORT=3001

# Origem(s) do front-end permitidas pelo CORS (separe por vírgula se precisar de mais de uma)
CORS_ORIGIN=http://localhost:3000

# Caminho da chave da service account do Firebase (a mesma usada pelo scraper Python)
FIREBASE_SERVICE_ACCOUNT_PATH=../scraper/serviceAccountKey.json

# Caminho do script Python do scraper, chamado via child_process
SCRAPER_PATH=../scraper/scraper.py
PYTHON_BIN=python3

# Expressão cron para a coleta em lote automática (padrão: a cada 6 horas)
SCRAPE_CRON=0 */6 * * *
